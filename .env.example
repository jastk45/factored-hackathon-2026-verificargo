# Copiar a .env y rellenar. NUNCA commitear .env.

# --- S3: dataset del hackathon ---
# Credenciales en la primera pagina del Data Dictionary.
# Solo lectura del bucket. NO son una API key de LLM.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an
S3_PREFIX=data/

# --- LLM ---
# Proveedor: openai_compatible | anthropic | azure | none
# "none" activa el modo deterministico con plantillas (sin llamadas de red).
LLM_PROVIDER=openai_compatible

# Endpoint. Para un servidor compatible con OpenAI incluye el sufijo /v1
#   vLLM / LiteLLM / proxy universidad : https://<host>/v1
#   Ollama local                       : http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Modelo pequeno para clasificar/extraer y uno mayor para redactar.
# Si solo hay uno, dejar ambos iguales.
LLM_MODEL_FAST=
LLM_MODEL_STRONG=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
