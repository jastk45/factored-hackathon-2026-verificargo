# Copiar a .env y rellenar. NUNCA commitear .env.

# --- S3: dataset del hackathon ---
# Credenciales en la primera pagina del Data Dictionary.
# Solo lectura del bucket. NO son una API key de LLM.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an
S3_PREFIX=data/

# --- LLM (solo extrae monto, fecha, comercio y moneda) ---
# Proveedor: ollama | openai | none
# "none" usa solo reglas (regex): el sistema funciona igual, sin llamadas de red.
LLM_PROVIDER=ollama
# Ollama: sin sufijo /v1 (se usa /api/generate).
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:1.7b
LLM_TIMEOUT_SECONDS=30
# Solo con LLM_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Identidad de la demo (mocks documentados, no seguridad real) ---
# Firma de los tokens: distinta en cada despliegue.
SESSION_SECRET=cambiar-en-cada-despliegue
# OTP de prueba para la verificación adicional del cliente.
TEST_OTP_CODE=123456
# Código de acceso de la consola del agente humano.
AGENT_ACCESS_CODE=agente-demo-2026
